#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

if [[ -n "${JAVA_HOME:-}" && -x "$JAVA_HOME/bin/java" ]]; then
  JAVA_CANDIDATE="$JAVA_HOME"
elif [[ "$(uname -s)" == "Darwin" && -x /usr/libexec/java_home ]]; then
  JAVA_CANDIDATE="$(/usr/libexec/java_home -v 17 2>/dev/null || true)"
else
  JAVA_CANDIDATE=""
fi

if [[ -z "$JAVA_CANDIDATE" ]]; then
  for candidate in \
    /opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home \
    /usr/local/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home \
    /opt/homebrew/Cellar/openjdk@17/*/libexec/openjdk.jdk/Contents/Home \
    /usr/local/Cellar/openjdk@17/*/libexec/openjdk.jdk/Contents/Home; do
    if [[ -x "$candidate/bin/java" ]]; then JAVA_CANDIDATE="$candidate"; break; fi
  done
fi

if [[ -z "$JAVA_CANDIDATE" || ! -x "$JAVA_CANDIDATE/bin/java" ]] ||
   ! "$JAVA_CANDIDATE/bin/java" -version 2>&1 | grep -Eq 'version "17\.|openjdk 17\.'; then
  printf '%s\n' 'error: Java 17 is required. Set JAVA_HOME to a JDK 17 installation (or install OpenJDK 17).' >&2
  exit 1
fi
export JAVA_HOME="$JAVA_CANDIDATE"
export PATH="$JAVA_HOME/bin:$PATH"

./scripts/validate
bash ./gradlew :watchface:assembleDebug
printf 'APK: %s\n' "$ROOT/watchface/build/outputs/apk/debug/watchface-debug.apk"
